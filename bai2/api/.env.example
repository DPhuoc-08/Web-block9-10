# Sao chép thành api/.env rồi điền giá trị thật (không commit .env).

# Project Supabase MỚI của Bài 2 (plan 12.1), KHÔNG dùng project của block7, Bài 1: seed xoá sạch database đang trỏ tới.
# Supabase → Connect → Session pooler, cổng 5432.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres"
PORT=3000

# Origin của SPA, không có dấu / cuối, không dùng *. WEB_ORIGIN dùng dựng link trong email.
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Ba khoá ngẫu nhiên, mỗi khoá một giá trị khác nhau, khác với Bài 1. Tạo từng khoá bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# JWT_SECRET: thiếu hoặc ngắn hơn 32 byte thì server không khởi động. MFA_ENCRYPTION_KEY: đúng 32 byte.
JWT_SECRET=
OTP_PEPPER=
MFA_ENCRYPTION_KEY=

# Tài khoản seed (đã kích hoạt). Bốn email phải khác nhau, mật khẩu 8–64 ký tự.
SEED_VIEWER_EMAIL=
SEED_EDITOR_A_EMAIL=
SEED_EDITOR_B_EMAIL=
SEED_ADMIN_EMAIL=
SEED_USER_PASSWORD=

# Gửi email: smtp (Gmail, khi demo) hoặc file (ghi .eml vào .mail-outbox/ cho script kiểm tra).
MAIL_TRANSPORT=smtp
MAIL_FROM=
SMTP_USER=
SMTP_PASS=

# Google reCAPTCHA v2 checkbox, domain localhost. Site key cũng điền vào web/.env; secret key chỉ ở đây.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAMES=localhost

# Bật để in câu SQL thật ra terminal; câu chạm bảng xác thực không in tham số.
# LOG_SQL=1
