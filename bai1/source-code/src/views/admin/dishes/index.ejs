<%- include("../../partials/header", { title }) %>
<%#
  Danh sách quản trị món (/admin/dishes?q=&mode=&page=) — chuyển từ AdminDishListPage.jsx của block7.
  Mỗi lần mở trang server chỉ đọc 20 món của trang đang xem; q, mode, page nằm trên URL (Reload / Back / copy link).
  Link Sửa / Xoá chỉ MỞ trang (form, xác nhận); không link nào tự ghi dữ liệu.
-%>
<%- include("../../partials/admin-nav", { current: "dishes" }) %>
<div class="toolbar">
  <h1 id="ket-qua" tabindex="-1" class="list-anchor">Món ăn</h1>
<% if (can("dish:create")) { -%>
  <a class="btn btn-primary" href="<%= newHref %>">+ Thêm món</a>
<% } -%>
</div>

<%# Thông báo theo quyền: ẩn nút chỉ để tiện dùng, server vẫn chặn ở từng route. -%>
<% if (!can("dish:update")) { -%>
<p class="notice" role="note">Tài khoản của bạn chỉ có quyền xem.</p>
<% } else if (!can("dish:create")) { -%>
<p class="notice" role="note">Tài khoản Editor này chưa được gắn với đầu bếp nào nên chưa thêm hay sửa món được. Hãy liên hệ quản trị viên.</p>
<% } -%>

<%- include("../../partials/admin-search", { base: "/admin/dishes", label: "Tìm món", total: result ? result.total : null }) %>

<div class="status-row">
<% if (can("dish:update")) { -%>
  <nav class="status-filter" aria-label="Lọc theo trạng thái">
<% for (const s of statusFilters) { %>    <a href="<%= statusHref(s.value) %>"<% if (s.value === state.status) { %> aria-current="true"<% } %>><%= s.label %></a>
<% } -%>
  </nav>
<% } -%>
<% if (result) { %>  <span class="muted"><%= result.total.toLocaleString("vi-VN") %> món</span>
<% } -%>
</div>

<% if (invalid) { -%>
<div class="panel empty" role="alert">
  <strong>Điều kiện tìm không hợp lệ</strong>
  <ul class="invalid-list">
<% for (const m of new Set(Object.values(errors))) { %>    <li><%= m %></li>
<% } -%>
  </ul>
  <a class="btn" href="/admin/dishes">Về trang 1</a>
</div>
<% } else if (result.total === 0) { -%>
<div class="panel empty"><%= state.q ? "Không có món nào khớp từ khoá." : filtered ? "Không có món nào khớp bộ lọc." : "Chưa có món nào." %></div>
<% } else if (result.items.length === 0) { -%>
<%# Trang vượt phạm vi (sửa tay URL, hoặc vừa xoá món cuối của trang cuối). -%>
<div class="panel empty">
  <strong>Trang <%= result.page %> không có món nào.</strong>
  <a href="<%= pageHref(totalPages) %>">Về trang cuối (<%= totalPages %>)</a>
</div>
<% } else { -%>
<div class="panel table-wrap">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Ảnh</th>
        <th>Tên</th>
        <th>Giá</th>
        <th class="col-tag">Tag</th>
        <th>Đầu bếp</th>
        <th>Tình trạng</th>
        <th>Trạng thái</th>
<% if (scored) { %>        <th>Điểm</th>
<% } -%>
<% if (can("dish:update")) { %>        <th><span class="sr-only">Thao tác</span></th>
<% } -%>
      </tr>
    </thead>
    <tbody>
<% for (const d of result.items) { -%>
<%# data-label: nhãn cột hiện trên điện thoại khi bảng chuyển thành thẻ. -%>
      <tr<% if (d.id === savedId) { %> class="just-saved"<% } %>>
        <td class="num" data-label="Mã"><%= d.id %></td>
        <td class="thumb" data-label="Ảnh"><%- include("../../partials/dish-image", { src: d.imageUrl, alt: "", cls: "table-thumb", tags: d.tags, label: false, lazy: true }) %></td>
        <td class="title" data-label="Tên"><% if (canEditDish(d)) { %><a href="<%= editHref(d.id) %>"><%= d.name %></a><% } else { %><%= d.name %><% } %></td>
        <td data-label="Giá"><%= formatPrice(d.price) %></td>
        <td class="col-tag" data-label="Tag"><%= tagNames(d.tags) %></td>
        <td data-label="Đầu bếp"><%= d.chef.name %></td>
        <td data-label="Tình trạng"><span class="badge <%= d.available ? "on" : "off" %>"><%= d.available ? "Đang phục vụ" : "Tạm hết" %></span></td>
        <td data-label="Trạng thái"><span class="badge <%= d.status %>"><%= d.status === "draft" ? "Nháp" : "Đã xuất bản" %></span></td>
<% if (scored) { %>        <td class="num" data-label="Điểm"><%= d.score.toFixed(3) %></td>
<% } -%>
<% if (can("dish:update")) { const editable = canEditDish(d); -%>
        <td class="actions">
<% if (editable) { -%>
<%# Đổi nhanh tình trạng: form POST thật, gửi giá trị đích và URL danh sách đang xem. -%>
          <form class="row-form" method="post" action="/admin/dishes/<%= d.id %>/availability?_method=PATCH" data-once>
            <input type="hidden" name="_csrf" value="<%= csrf() %>">
            <input type="hidden" name="back" value="<%= listUrl %>">
            <input type="hidden" name="available" value="<%= d.available ? "false" : "true" %>">
            <button type="submit" class="btn btn-sm" data-busy-label="Đang đổi…"><%= d.available ? "Đặt tạm hết" : "Mở phục vụ" %></button>
          </form>
          <a class="btn btn-sm" href="<%= editHref(d.id) %>">Sửa</a>
<% } if (can("dish:delete")) { -%>
          <a class="btn btn-sm danger-text" href="<%= deleteHref(d.id) %>">Xoá</a>
<% } if (!editable) { -%>
          <span class="muted">Chỉ xem</span>
<% } -%>
        </td>
<% } -%>
      </tr>
<% } -%>
    </tbody>
  </table>
</div>
<p class="muted page-summary">Món <%= (result.page - 1) * result.pageSize + 1 %>–<%= (result.page - 1) * result.pageSize + result.items.length %> trong <%= result.total %> món</p>
<%- include("../../partials/pagination", { page: result.page, totalPages, pages, pageHref: (n) => pageHref(n) + "#ket-qua", label: "Phân trang món ăn" }) %>
<% } -%>

<%- include("../../partials/footer") %>
