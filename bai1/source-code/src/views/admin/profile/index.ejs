<%- include("../../partials/header", { title }) %>
<%# Hồ sơ của chính người đang đăng nhập (/admin/profile). Thông tin tài khoản chỉ đọc; chỉ tên hiển thị sửa được. -%>
<% const shownName = profile.username ?? profile.email; -%>
<%- include("../../partials/admin-nav", { current: "" }) %>
<%# Figma M5b: vừa đăng nhập bằng mã khôi phục, thường là đã mất thiết bị (ghi chú 22). -%>
<% if (recoveryJustUsed && mfa.enabled) { -%>
<div class="recovery-nudge" role="status">
  <div>
    <strong>Bạn vừa đăng nhập bằng mã khôi phục</strong>
    <p>Còn <%= mfa.remaining %> mã dùng được. Nếu đã mất điện thoại, hãy đổi thiết bị và tạo lại mã khôi phục.</p>
  </div>
  <a class="btn btn-primary" href="/admin/profile/mfa/reauth/replace">Đổi thiết bị</a>
</div>
<% } -%>
<div class="profile">
  <section class="panel profile-card" aria-labelledby="profile-title">
    <div class="profile-head">
      <span class="profile-avatar" aria-hidden="true"><%= [...shownName][0].toLocaleUpperCase("vi") %></span>
      <div class="profile-name">
        <h1 id="profile-title"><%= shownName %></h1>
<% if (profile.username) { %>        <p class="muted"><%= profile.email %></p>
<% } -%>
      </div>
    </div>
    <dl class="facts">
      <dt>Trạng thái</dt>
      <dd><%= profile.statusLabel %></dd>
      <dt>Xác minh email</dt>
      <dd><%= profile.verifiedAt %></dd>
      <dt>Ngày tạo</dt>
      <dd><%= profile.joinedAt %></dd>
    </dl>
  </section>

  <div class="profile-side">
<%# Bảo mật hai lớp (Figma M6): lối vào duy nhất của thiết lập và xác thực lại. Không có "xem lại mã" vì mã chỉ lưu dạng hash. -%>
    <section class="panel profile-card" aria-labelledby="profile-mfa-title">
      <div class="card-head">
        <h2 id="profile-mfa-title">Bảo mật hai lớp</h2>
        <span class="badge <%= mfa.enabled ? "on" : "published" %>"><%= mfa.enabled ? "Đã bật" : "Chưa bật" %></span>
      </div>
<% if (mfa.enabled) { -%>
      <p class="muted">Mỗi lần đăng nhập cần thêm mã 6 số từ ứng dụng xác thực trên điện thoại.</p>
      <p class="mfa-count"><span class="muted">Mã khôi phục còn lại</span><strong><%= mfa.remaining %> / 10</strong></p>
      <div class="mfa-actions">
        <a class="btn" href="/admin/profile/mfa/reauth/replace">Đổi thiết bị</a>
        <a class="btn" href="/admin/profile/mfa/reauth/regenerate">Tạo lại mã khôi phục</a>
        <a class="btn danger-text" href="/admin/profile/mfa/reauth/disable">Tắt xác thực hai lớp</a>
      </div>
<% } else { -%>
      <p class="muted">Thêm một lớp bảo vệ: sau mật khẩu, đăng nhập cần mã 6 số từ ứng dụng xác thực trên điện thoại.</p>
      <form method="post" action="/admin/profile/mfa/setup" data-once>
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <button type="submit" class="btn btn-primary btn-block" data-busy-label="Đang mở…">Bật xác thực hai lớp</button>
      </form>
<% } -%>
    </section>

    <section class="panel profile-card" aria-labelledby="profile-name-title">
      <h2 id="profile-name-title">Tên hiển thị</h2>
<% if (Object.keys(errors).length) { %>      <p class="alert" role="alert" data-focus-first-error>Dữ liệu chưa hợp lệ, vui lòng sửa bên dưới.</p>
<% } -%>
      <form class="form" method="post" action="/admin/profile?_method=PATCH" novalidate data-once data-unsaved-guard>
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <label class="field<%= errors.username ? " invalid" : "" %>">
          <span>Tên</span>
          <input name="username" value="<%= values.username %>" autocomplete="name" maxlength="50">
          <span class="hint">2–50 ký tự. Hiện ở đầu trang, không dùng để đăng nhập.</span>
<% if (errors.username) { %>          <span class="error"><%= errors.username %></span>
<% } -%>
        </label>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" data-busy-label="Đang lưu…">Lưu tên</button>
        </div>
      </form>
    </section>

    <section class="panel profile-card" aria-labelledby="profile-password-title">
      <h2 id="profile-password-title">Mật khẩu</h2>
      <p class="muted">Sau khi đổi, các thiết bị khác sẽ bị đăng xuất.</p>
      <a class="btn" href="/admin/profile/password">Đổi mật khẩu</a>
    </section>
  </div>
</div>
<%- include("../../partials/footer") %>
