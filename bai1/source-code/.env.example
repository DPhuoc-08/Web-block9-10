# Sao chép file này thành .env rồi điền giá trị thật (không commit .env).

# Database: CHÍNH project Supabase của block7 (đã chốt). Supabase → Connect → Session pooler, cổng 5432.
# Seed của block8 xoá sạch rồi tạo lại dữ liệu của database đang trỏ tới (dữ liệu block7 ra y hệt vì seed tất định).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres"
PORT=3000

# Bật để in từng câu SQL thật (kèm tham số) ra terminal — dùng làm bằng chứng nộp. Mặc định tắt.
# LOG_SQL=1

# Địa chỉ gốc của ứng dụng: dựng link trong email (không lấy từ header Host) và so với header Origin (chống CSRF).
APP_ORIGIN=http://localhost:3000

# Bí mật ký cookie phiên (express-session) và "pepper" của mã OTP. Chuỗi ngẫu nhiên dài, tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
OTP_PEPPER=

# Khoá AES-256-GCM mã hoá TOTP secret (block9): đúng 32 byte, dạng base64url. Khác SESSION_SECRET, OTP_PEPPER. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=

# Tài khoản seed (đã kích hoạt): viewer, editor gắn đầu bếp A, editor gắn đầu bếp B, admin. Nên dùng Gmail của nhóm với dấu +
# để cùng về một hộp thư, ví dụ ten+viewer@gmail.com, ten+editor-a@gmail.com. Bốn email phải khác nhau. Mật khẩu 8–64 ký tự.
SEED_VIEWER_EMAIL=
SEED_EDITOR_A_EMAIL=
SEED_EDITOR_B_EMAIL=
SEED_ADMIN_EMAIL=
SEED_USER_PASSWORD=

# Gửi email: smtp (Gmail, khi demo) hoặc file (ghi .eml vào .mail-outbox/ cho script kiểm tra).
MAIL_TRANSPORT=file
MAIL_FROM="Nhà hàng <dia-chi-gmail-gui@gmail.com>"
# Gmail SMTP: tài khoản bật xác minh 2 bước → Google Account → Security → App passwords.
SMTP_USER=
SMTP_PASS=

# Google reCAPTCHA v2 checkbox: tạo key tại https://www.google.com/recaptcha/admin, thêm domain localhost.
# Site key công khai (in vào trang); secret key chỉ ở đây. RECAPTCHA_HOSTNAMES: hostname được chấp nhận trong kết quả siteverify.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAMES=localhost
# Script kiểm tra (check-auth, collect-evidence) KHÔNG dùng key ở đây mà đọc file riêng source-code/.env.test, gồm 3 dòng
# RECAPTCHA_SITE_KEY / RECAPTCHA_SECRET_KEY = cặp key thử công khai trong FAQ của Google reCAPTCHA
# ("I'd like to run automated tests with reCAPTCHA"), RECAPTCHA_HOSTNAMES=localhost,testkey.google.com.
# Key thử cho mọi token qua → không dùng khi demo, không làm bằng chứng chặn bot.
